{
  "name": "thesis-writing-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:writing": "textlint \"0[0-8]-*.tex\" \"9[1-4]-appendix-*.tex\"",
    "lint:writing:fix": "textlint --fix \"0[0-8]-*.tex\" \"9[1-4]-appendix-*.tex\"",
    "lint:ai-style": "node scripts/ai-style-check.mjs",
    "lint:languagetool": "node scripts/languagetool-check.mjs",
    "lint:all-writing": "npm run lint:writing && npm run lint:ai-style",
    "mcp:textlint": "textlint --mcp"
  },
  "devDependencies": {
    "textlint": "^15.6.1",
    "textlint-plugin-latex2e": "^1.2.1",
    "textlint-rule-common-misspellings": "^1.0.1",
    "textlint-rule-no-doubled-conjunction": "^3.0.0",
    "textlint-rule-no-start-duplicated-conjunction": "^2.0.2",
    "textlint-rule-terminology": "^5.2.16",
    "textlint-rule-write-good": "^2.0.0"
  }
}
